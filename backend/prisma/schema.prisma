// Prisma Schema for VoiceBroadcastPro / VSMS (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SERVICE_PROVIDER
  MASTER_RESELLER
  SUB_RESELLER
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  TERMINATED
}

enum TransactionType {
  CREDIT
  DEBIT
  RESERVE
  RELEASE
  REFUND
  COMMISSION
  ADJUSTMENT
}

enum ReferenceType {
  CAMPAIGN
  CALL
  RECHARGE
  TRANSFER
  REFUND
  GATEWAY
  MANUAL_ADJUSTMENT
}

enum CallStatus {
  PENDING
  INITIATED
  RINGING
  ANSWERED
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  PENDING
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// -------------------------------------------------------------
// 1. User & Reseller Hierarchy
// -------------------------------------------------------------

model User {
  id                    String        @id @default(uuid())
  legacyId              Int?          @unique
  role                  Role          @default(CUSTOMER)
  name                  String
  email                 String        @unique
  phone                 String?
  passwordHash          String
  companyName           String?
  avatarUrl             String?
  emailVerifiedAt       DateTime?
  status                AccountStatus @default(ACTIVE)

  // KYC Documents & Verification
  frontNid              String?
  backNid               String?

  // Customer Calling & Approval Settings
  audioType             String        @default("both") // upload, tts, both
  autoApproveAudio      Boolean       @default(false)
  autoApproveCampaigns  Boolean       @default(false)
  pulseRate             Decimal       @default(0.0000) @db.Decimal(15, 6)
  pulseDuration         Int           @default(10)

  // Hierarchy Tree
  parentId              String?
  parent                User?         @relation("ResellerTree", fields: [parentId], references: [id], onDelete: SetNull)
  children              User[]        @relation("ResellerTree")
  path                  String        // Materialized lineage path (e.g., "root_id/sp_id/reseller_id")
  depth                 Int           @default(0)

  // Commercial / Pricing Plan Assigned
  pricingPlanId         String?
  pricingPlan           PricingPlan?  @relation(fields: [pricingPlanId], references: [id])

  // Financial Settings
  allowNegativeBalance  Boolean       @default(false)
  creditLimit           Decimal       @default(0.0000) @db.Decimal(18, 4)

  // Relations
  wallet                Wallet?
  ledgerEntries         LedgerEntry[]
  campaigns             Campaign[]
  calls                 CallRecord[]
  createdPlans          PricingPlan[] @relation("PlanCreator")
  sentTransfers         BalanceTransfer[] @relation("TransferSender")
  receivedTransfers     BalanceTransfer[] @relation("TransferReceiver")
  rechargeRequests      RechargeRequest[]
  reportExports         ReportExport[]
  audioAssets           AudioAsset[]
  contactGroups         ContactGroup[]
  sipTrunks             SipTrunk[]
  callers               CallerId[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([role])
  @@index([status])
}

// -------------------------------------------------------------
// 2. Wallet & Immutable Ledger (Financial Integrity)
// -------------------------------------------------------------

model Wallet {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         String        @default("BDT")
  balance          Decimal       @default(0.0000) @db.Decimal(18, 4)
  reservedBalance  Decimal       @default(0.0000) @db.Decimal(18, 4)
  creditLimit      Decimal       @default(0.0000) @db.Decimal(18, 4)
  version          Int           @default(1) // Optimistic concurrency control

  ledgerEntries    LedgerEntry[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model LedgerEntry {
  id              String          @id @default(uuid())
  legacyId        Int?            @unique
  walletId        String
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  type            TransactionType
  amount          Decimal         @db.Decimal(18, 4)
  balanceBefore   Decimal         @db.Decimal(18, 4)
  balanceAfter    Decimal         @db.Decimal(18, 4)

  referenceType   ReferenceType
  referenceId     String?
  idempotencyKey  String?         @unique
  description     String

  metadata        Json?

  createdAt       DateTime        @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([referenceType, referenceId])
  @@index([type])
  @@index([createdAt])
}

model BalanceTransfer {
  id            String          @id @default(uuid())
  fromUserId    String
  fromUser      User            @relation("TransferSender", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User            @relation("TransferReceiver", fields: [toUserId], references: [id])

  amount        Decimal         @db.Decimal(18, 4)
  currency      String          @default("BDT")
  note          String?

  createdAt     DateTime        @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model RechargeRequest {
  id              String        @id @default(uuid())
  legacyId        Int?          @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Decimal       @db.Decimal(18, 4)
  currency        String        @default("BDT")
  paymentMethod   String        // "bKash", "Nagad", "Bank", "Manual"
  transactionRef  String?
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  note            String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// -------------------------------------------------------------
// 3. Advanced Pricing & Rate Cards
// -------------------------------------------------------------

model PricingPlan {
  id          String      @id @default(uuid())
  name        String
  description String?
  creatorId   String
  creator     User        @relation("PlanCreator", fields: [creatorId], references: [id])
  isDefault   Boolean     @default(false)

  rateCards   RateCard[]
  assignedTo  User[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([creatorId])
}

model RateCard {
  id                String       @id @default(uuid())
  planId            String
  plan              PricingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  destinationPrefix String       @default("DEFAULT") // e.g. "880", "88017", "DEFAULT"
  destinationName   String       @default("Bangladesh All")

  buyRate           Decimal      @db.Decimal(12, 4)  // Telecom provider cost
  sellRate          Decimal      @db.Decimal(12, 4)  // Base selling rate
  pulseDuration     Int          @default(10)        // In seconds (e.g., 1s, 10s, 30s)
  pulseRate         Decimal      @db.Decimal(12, 4)  // Cost per pulse

  effectiveFrom     DateTime     @default(now())
  effectiveTo       DateTime?
  isActive          Boolean      @default(true)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([planId, destinationPrefix])
  @@index([isActive])
}

// -------------------------------------------------------------
// 4. Asterisk Telephony, Servers & SIP Trunks
// -------------------------------------------------------------

model AsteriskServer {
  id              String      @id @default(uuid())
  legacyId        Int?        @unique
  name            String
  ariBaseUrl      String      // http://103.234.119.204:8088
  ariUsername     String
  ariPassword     String
  maxConcurrency  Int         @default(100)
  activeChannels  Int         @default(0)
  isOnline        Boolean     @default(true)
  enabled         Boolean     @default(true)

  trunks          SipTrunk[]
  callers         CallerId[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SipTrunk {
  id              String          @id @default(uuid())
  legacyId        Int?            @unique
  serverId        String
  server          AsteriskServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  name            String          @unique // e.g. telco-trunk-01, bdpbx-999
  provider        String          @default("custom")
  type            String          @default("ip") // ip, registration
  host            String          // 103.234.119.204
  port            Int             @default(5060)
  transport       String          @default("transport-udp")
  username        String?
  password        String?
  outboundCid     String?
  codecs          String          @default("alaw,ulaw,g729")
  context         String          @default("from-pstn")
  maxConcurrency  Int             @default(30)
  activeCalls     Int             @default(0)
  enabled         Boolean         @default(true)
  isOnline        Boolean         @default(true)
  notes           String?

  callers         CallerId[]
  campaigns       Campaign[]
  calls           CallRecord[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([serverId])
  @@index([userId])
}

model CallerId {
  id              String          @id @default(uuid())
  legacyId        Int?            @unique
  serverId        String
  server          AsteriskServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  sipTrunkId      String?
  sipTrunk        SipTrunk?       @relation(fields: [sipTrunkId], references: [id], onDelete: SetNull)
  callerName      String
  callerNumber    String
  trunkName       String
  maxConcurrency  Int             @default(10)
  isOnline        Boolean         @default(true)
  enabled         Boolean         @default(true)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([serverId])
  @@index([userId])
}

// -------------------------------------------------------------
// 5. Audio & Contact Management
// -------------------------------------------------------------

model AudioAsset {
  id              String      @id @default(uuid())
  legacyId        Int?        @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  title           String
  originalPath    String
  convertedPath   String?     // Converted 8kHz 16-bit mono WAV for Asterisk
  durationSeconds Int         @default(0)
  isTTS           Boolean     @default(false)
  ttsText         String?
  language        String?     @default("bn-BD")
  isApproved      Boolean     @default(true)
  approval        String      @default("approved")
  fileSize        Int?

  campaigns       Campaign[]
  calls           CallRecord[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
}

model ContactGroup {
  id              String      @id @default(uuid())
  legacyId        Int?        @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  name            String
  totalContacts   Int         @default(0)

  contacts        Contact[]
  campaigns       Campaign[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
}

model Contact {
  id          String        @id @default(uuid())
  legacyId    Int?          @unique
  groupId     String
  group       ContactGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String?
  phoneNumber String
  customData  Json?

  createdAt   DateTime      @default(now())

  @@index([groupId, phoneNumber])
}

// -------------------------------------------------------------
// 6. Voice Campaign & Call Detail Records (CDR)
// -------------------------------------------------------------

model Campaign {
  id               String          @id @default(uuid())
  legacyId         Int?            @unique
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  name             String
  audioId          String
  audio            AudioAsset      @relation(fields: [audioId], references: [id])
  groupId          String
  group            ContactGroup    @relation(fields: [groupId], references: [id])
  trunkId          String?
  trunk            SipTrunk?       @relation(fields: [trunkId], references: [id])

  status           CampaignStatus  @default(DRAFT)
  scheduledAt      DateTime?

  // Aggregate Counters
  totalContacts    Int             @default(0)
  processedCalls   Int             @default(0)
  answeredCalls    Int             @default(0)
  failedCalls      Int             @default(0)
  totalDuration    Int             @default(0) // seconds

  // Financial Stats
  estimatedCost    Decimal         @default(0.0000) @db.Decimal(18, 4)
  actualCost       Decimal         @default(0.0000) @db.Decimal(18, 4)
  resellerProfit   Decimal         @default(0.0000) @db.Decimal(18, 4)

  calls            CallRecord[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model CallRecord {
  id              String       @id @default(uuid())
  legacyId        Int?         @unique
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trunkId         String?
  trunk           SipTrunk?    @relation(fields: [trunkId], references: [id])
  audioId         String?
  audio           AudioAsset?  @relation(fields: [audioId], references: [id])

  // Call Attributes
  phoneNumber     String
  callerId        String
  uniqueId        String?      // Asterisk uniqueid
  channelId       String?
  isOtp           Boolean      @default(false)
  otpCode         String?

  status          CallStatus   @default(PENDING)
  hangupCause     String?      // NORMAL_CLEARING, USER_BUSY, NO_ANSWER, etc.

  // Telephony Timings
  initiatedAt     DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  duration        Int          @default(0) // total call duration
  billableSeconds Int          @default(0) // billable talk duration

  // Financial Snapshot (Preserved at billing time)
  costPrice       Decimal      @default(0.0000) @db.Decimal(12, 4)
  sellingPrice    Decimal      @default(0.0000) @db.Decimal(12, 4)
  grossProfit     Decimal      @default(0.0000) @db.Decimal(12, 4)
  resellerMargin  Decimal      @default(0.0000) @db.Decimal(12, 4)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([uniqueId])
  @@index([createdAt])
  @@index([phoneNumber])
}

// -------------------------------------------------------------
// 7. Advanced Reporting & Asynchronous Exports
// -------------------------------------------------------------

model ReportExport {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  reportType  String        // "CDR", "CAMPAIGN", "FINANCIAL", "RESELLER_PERFORMANCE"
  filterParams Json?
  fileFormat  String        @default("CSV") // "CSV", "EXCEL", "PDF"
  filePath    String?
  status      ExportStatus  @default(PENDING)
  errorMessage String?
  totalRows   Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}
